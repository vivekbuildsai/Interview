# Copy this file to .env.local (gitignored) and fill in real values from
# your Supabase project dashboard: Project Settings -> API.
#
# Both values below are PUBLIC/publishable by design -- Supabase's anon key
# is meant to ship in frontend bundles and is safe in version control's
# .env.example as a placeholder (never commit the real one, though: Vite
# bundles it at build time, so treat .env.local as local-only). Actual data
# access control comes from PostgreSQL Row Level Security, not from keeping
# this key secret. Never put a service_role/secret key in any VITE_ variable
# or anywhere else in this frontend-only app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
